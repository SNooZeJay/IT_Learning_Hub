{
  "name": "vue-tailwind-admin-dashboard",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"e2e/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run check:workflows && npm run check:impeccable && npm run test && npm run type-check && npm run lint && npm run build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "check:workflows": "node scripts/check-workflow-expressions.mjs",
    "check:impeccable": "node scripts/check-impeccable-hook.mjs"
  },
  "dependencies": {
    "@fullcalendar/vue3": "^7.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "apexcharts": "^7.1.0",
    "flatpickr": "^4.6.13",
    "fullcalendar": "^7.1.0",
    "gsap": "^3.15.0",
    "jsvectormap": "^1.6.0",
    "lucide-vue-next": "^0.474.0",
    "ogl": "^1.0.11",
    "pinia": "^4.0.3",
    "vue": "^3.5.26",
    "vue-flatpickr-component": "^11.0.5",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1",
    "vuevectormap": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.12"
  },
  "description": "IT Learning Hub - a role-based Learning Management System for students, instructors and admins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SNooZeJay/IT_Learning_Hub.git"
  },
  "homepage": "https://it-learning-hub.vercel.app"
}
