# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

/cypress/videos/
/cypress/screenshots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo
.vercel

# Environment files. .env.example is committed as documentation;
# every real .env stays local so credentials are never pushed.
.env*
!.env.example

# Seed credentials. The committed example has placeholder values; the real
# one holds the service-role key and passwords and must never be pushed.
scripts/*.local.json

# Impeccable's compiled engine binary, 16MB and platform-specific. The skill's
# own launcher downloads this on first run when it is missing, so excluding it
# costs a fresh clone nothing and keeps a windows-x64 executable out of a repo
# that also builds on macOS and Linux. The launcher, its hash check and every
# markdown reference stay committed.
.agents/skills/impeccable/scripts/bin/

# Playwright. Traces, screenshots and reports are run artefacts, not source.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Audit output. The sweeps write screenshots and JSON reports; they are evidence for a
# run, not something the repository should carry.
/audit-out/
/reports/

# Lighthouse reports. Written into the working directory by the audit runs; they are
# evidence for a run, and a 150KB JSON blob failing the formatting check is not.
/lh-*.json
/lighthouse-report.*

# Python bytecode. The ui-ux-pro-max search tool is Python and writes this
# cache next to itself; it is a build artefact of running the tool, not source.
__pycache__/
*.pyc
