# IT Learning Hub - browser environment
#
# Copy this file to .env and fill in the values from your Supabase project:
#   Dashboard > Project Settings > API
#
# Only the PUBLISHABLE key belongs here. It is a publishable key: Row Level Security,
# not the key itself, decides what a visitor can read or write.
#
# The PayMongo SECRET key must NOT appear in this file or in any VITE_ variable.
# Anything prefixed VITE_ is compiled into the public JavaScript bundle and can be
# read by anyone who opens devtools. PayMongo's secret is held as a Supabase
# secret and read only inside an Edge Function.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
